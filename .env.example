# Endereço do servidor LiveKit que o NAVEGADOR vai acessar.
#  - Servidor local (docker compose):  ws://localhost:7880
#  - LiveKit Cloud:                    wss://SEU-PROJETO.livekit.cloud
LIVEKIT_URL=ws://localhost:7880

# Chaves do LiveKit. As de baixo são as do modo de desenvolvimento (--dev).
# No LiveKit Cloud: Settings > Keys.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Validade do token de cada participante, em horas.
TOKEN_TTL_HOURS=6

# Código opcional para entrar nas salas (deixe vazio para desativar).
ACCESS_CODE=

# Onde o site Python escuta. Use 0.0.0.0 para aceitar acessos da rede.
HOST=127.0.0.1
PORT=8000
